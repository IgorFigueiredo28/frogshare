{
  "name": "screen-share-app",
  "version": "1.5.0",
  "description": "Screen sharing with per-process audio capture",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "build:native:mac": "swiftc -O -target arm64-apple-macos11 native/mac/AudioCapture.swift -o native/AudioCapture-mac",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "com.screenshare.app",
    "productName": "FrogShare",
    "win": {
      "icon": "server/public/brand/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "native/AudioCapture.exe",
          "to": "native/AudioCapture.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "server/public/brand/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "server/public/brand/icon-512.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "O FrogShare captura o som do app escolhido para transmitir junto com a tela.",
        "NSScreenCaptureUsageDescription": "O FrogShare grava a tela ou janela escolhida para transmitir aos seus amigos."
      },
      "extraResources": [
        {
          "from": "native/AudioCapture-mac",
          "to": "native/AudioCapture-mac"
        }
      ]
    },
    "dmg": {
      "title": "FrogShare"
    },
    "afterSign": "build/adhoc-sign.js",
    "asar": true
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}

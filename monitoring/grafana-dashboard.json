    {
      "id": 15,
      "type": "row",
      "title": "Quem transmite",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "barchart",
      "title": "Versões em uso (minutos transmitidos)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_FROGSHARE}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_FROGSHARE}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(app_version, '?') AS versao, count(*) AS minutos FROM monitoring.host_quality WHERE $__timeFilter(time) GROUP BY 1 UNION ALL SELECT 'navegador', count(*) FROM monitoring.web_host_quality WHERE $__timeFilter(time) HAVING count(*) > 0 ORDER BY 2 DESC"
        }
      ],
      "description": "Mostra se a atualização automática chegou em todo mundo.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "versao",
        "showValue": "auto",
        "barWidth": 0.7,

{
  "__inputs": [
    {
      "name": "DS_FROGSHARE",
      "label": "FrogShare (Supabase)",
      "description": "O PostgreSQL do Supabase, com o login grafana_reader",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    }
  ],
  "title": "FrogShare ao vivo",
  "uid": "frogshare-publico",
  "description": "Os números do FrogShare em produção: quem assiste, como a imagem chega e o uso dos planos grátis. Só totais, sem dados de pessoas.",
  "tags": [
    "frogshare",
    "publico"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "schemaVersion": 39,
  "version": 3,
  "links": [
    {
      "title": "FrogShare",
      "type": "link",
      "url": "https://frogshare.onrender.com",
      "targetBlank": true,
      "icon": "external link",
      "tooltip": "O site do FrogShare"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "Transmissões agora",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_FROGSHARE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_FROGSHARE}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '5m', 0), max(streams) AS \"transmissões\" FROM monitoring.server_stats WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Do retrato que o servidor grava a cada 5 minutos enquanto está acordado.",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "text": {
          "titleSize": 13,
          "valueSize": 30
        }
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Assistindo agora",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_FROGSHARE}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_FROGSHARE}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(time, '5m', 0), max(viewers) AS assistindo FROM monitoring.server_stats WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1"
        }
      ],
      "description": "Do retrato que o servidor grava a cada 5 minutos enquanto está acordado.",
      "fieldConfig": {
